# Copy to .env and edit. Every value is optional.
# Settings you change in the UI are stored in ~/.config/quickai/config.json
# and win over the *_BASE_URL / *_MODEL defaults below after first run.

# Where QuickAI listens. Keep 127.0.0.1 unless you want other devices in.
QUICKAI_HOST=127.0.0.1
QUICKAI_PORT=7431

# Seeds the config the very first time it is created.
QUICKAI_BASE_URL=http://localhost:8000
# QUICKAI_MODEL=llama3
# QUICKAI_API_KEY=

# Required if QUICKAI_HOST is not localhost: shared secret for the UI.
# Open http://<host>:7431/?token=... once and it is remembered in a cookie.
# QUICKAI_TOKEN=change-me

# Move the config file somewhere else if you like.
# QUICKAI_CONFIG=/home/you/.config/quickai/config.json

# DEBUG for verbose logs.
# QUICKAI_LOG_LEVEL=INFO
